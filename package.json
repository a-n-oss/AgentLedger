{
  "name": "agentledger",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @agentledger/web dev",
    "build": "pnpm -r --filter @agentledger/shared --filter @agentledger/db --filter @agentledger/sdk --filter @agentledger/web build",
    "db:generate": "pnpm --filter @agentledger/db generate",
    "db:migrate": "pnpm --filter @agentledger/db migrate",
    "db:seed": "pnpm --filter @agentledger/db seed",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
