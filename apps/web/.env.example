# Database
# Local docker compose maps host 5433 → container 5432
# Railway/Neon: use the platform-injected DATABASE_URL
DATABASE_URL=postgres://postgres:postgres@localhost:5433/agentledger

# Enable the seeded /demo console (no Clerk). /app is always the live app and requires Clerk.
# true: public Railway docs/demo site, or local explore via /demo
# false: hide /demo (private hosted)
AGENTLEDGER_DEMO_MODE=true
SEED_CLERK_ORG_ID=org_demo_agentledger

# App URL (localhost for self-host; https for any deployed demo)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Master key for BYOK provider secrets (AES-256-GCM). Required to save keys in the UI.
# Generate: openssl rand -base64 32
AGENTLEDGER_SECRETS_KEY=

# Optional self-host fallback when a project has no BYOK secret (leave unset on public demo)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=

# Clerk (required when AGENTLEDGER_DEMO_MODE=false)
# Create/link via: npx clerk apps create "AgentLedger" && npx clerk link --app <id> && npx clerk env pull
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/app
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/app
# Hosted: hide public sign-up UI (still disable sign-ups in Clerk Dashboard)
NEXT_PUBLIC_CLERK_INVITE_ONLY=false

# Stripe (deferred while BYOK-first; optional later)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
STRIPE_METERED_PRICE=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Email / alerts (Resend). Use a verified from-address for smoke tests.
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@agentledger.dev

# Inngest (optional — alerts fall back to inline when unset / in demo)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
