# Database (docker compose maps 5433→5432)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/agentledger

# Demo mode — skip Clerk and use a seeded demo org
AGENTLEDGER_DEMO_MODE=true
SEED_CLERK_ORG_ID=org_demo_agentledger

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Provider keys used by the proxy (server-side)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Clerk (optional when DEMO_MODE=true)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/app
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/app

# Stripe (optional in demo)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
STRIPE_METERED_PRICE=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Email / alerts
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@agentledger.dev

# Inngest (optional — alerts fall back to inline in demo)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
