# Database
# Local docker compose maps host 5433 → container 5432
# Railway/Neon: use the platform-injected DATABASE_URL
DATABASE_URL=postgres://postgres:postgres@localhost:5433/agentledger

# Seeded /demo console (no Clerk). Off by default — product path is self-host /app.
# true: local explore only via /demo
# false: hide /demo (recommended for private hosted / Railway)
AGENTLEDGER_DEMO_MODE=false
SEED_CLERK_ORG_ID=org_demo_agentledger

# App URL (localhost for self-host; https for deployed hosts)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Master key for BYOK provider secrets (AES-256-GCM). Required to save keys in the UI.
# Generate: openssl rand -base64 32
AGENTLEDGER_SECRETS_KEY=

# Optional self-host fallback when a project has no BYOK secret (prefer BYOK UI in multi-tenant)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=

# Clerk (required for /app)
# Create/link via: npx clerk apps create "AgentLedger" && npx clerk link --app <id> && npx clerk env pull
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/app
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/app
# Hide public sign-up UI (still disable sign-ups in Clerk Dashboard). Invite with: pnpm invite -- email@…
NEXT_PUBLIC_CLERK_INVITE_ONLY=true

# SaaS Stripe billing is deferred. Leave unset / false for self-host (full entitlements unlocked).
# AGENTLEDGER_BILLING_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
STRIPE_METERED_PRICE=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Email / alerts (Resend). Use a verified from-address (onboarding@resend.dev works for Resend smoke).
RESEND_API_KEY=
ALERT_FROM_EMAIL=onboarding@resend.dev

# Inngest (optional — alerts fall back to inline when unset / in demo)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
